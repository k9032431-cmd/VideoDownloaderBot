# @BotFather-dan alnan token (hökman)
BOT_TOKEN=

# Bir wagtda näçe wideo ýüklenip bilýär
MAX_CONCURRENT=3

# Diňe şu ulanyjylar boty ulanyp bilsin (ID-leri otur bilen). Boş = hemmeler.
ALLOWED_USERS=

# --- Goşmaça: 2 GB-a çenli wideo ugratmak üçin (my.telegram.org) ---
# Doldursaňyz, install.sh ýerli Telegram Bot API serweri bilen işledýär.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
